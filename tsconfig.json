{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test", "*.ts", "worker-configuration.d.ts"]
}
